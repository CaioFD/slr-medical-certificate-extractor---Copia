# === ARQUIVO: .env_template ===
# Copie este arquivo para .env e configure suas chaves

# API do Google Gemini (OBRIGATÓRIO para OCR real)
GEMINI_API_KEY=sua_chave_gemini_aqui
API_KEY=sua_chave_gemini_aqui

# Database (OPCIONAL - se não configurar, vai funcionar sem banco)
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_DB=atestados_db
PSQL_USER=postgres
PSQL_PASS=sua_senha_postgres

# Environment
ENVIRONMENT=development
